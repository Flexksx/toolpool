<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE module PUBLIC
        "-//Checkstyle//DTD Checkstyle Configuration 1.3//EN"
        "https://checkstyle.org/dtds/configuration_1_3.dtd">

<module name="Checker">
    <property name="severity" value="error"/>
    <property name="fileExtensions" value="java"/>

    <module name="TreeWalker">
        <module name="DeclarationOrder">
            <property name="ignoreConstructors" value="false"/>
            <property name="ignoreModifiers" value="false"/>
        </module>

        <module name="InnerTypeLast"/>

        <module name="ModifierOrder"/>
        <module name="OverloadMethodsDeclarationOrder"/>
        <module name="UnusedImports">
        </module>

        <module name="MatchXpath">
            <property name="id" value="TestMethodName"/>
            <property name="query" value="//METHOD_DEF[MODIFIERS/ANNOTATION/IDENT[@text='Test' or @text='ParameterizedTest']]/IDENT[matches(@text, '^(a|an|the)[A-Z]') or not(matches(@text, '^[a-z][a-zA-Z0-9]*_[a-z][a-zA-Z0-9]*$'))]"/>
            <message key="matchxpath.match" value="A test name must match methodUnderTestCondition_outcome and must not start with an article."/>
        </module>

        <module name="MatchXpath">
            <property name="id" value="MapperMethodName"/>
            <property name="query" value="//CLASS_DEF[IDENT[ends-with(@text, 'Mapper')]]/OBJBLOCK/METHOD_DEF[MODIFIERS/LITERAL_PUBLIC or MODIFIERS/LITERAL_STATIC]/IDENT[not(matches(@text, '^to[A-Z]'))]"/>
            <message key="matchxpath.match" value="A public or static method of a Mapper class must be named toX."/>
        </module>
    </module>
</module>