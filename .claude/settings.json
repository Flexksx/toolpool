{
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "jq -e \".stop_hook_active // false\" >/dev/null 2>&1 && exit 0; just ci all || exit 2",
            "timeout": 900,
            "statusMessage": "Running moon ci on affected projects"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.agents/scripts/session-context.sh"
          }
        ]
      }
    ]
  }
}
