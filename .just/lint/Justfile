set working-directory := "../.."

[private]
default:
    just --list --justfile {{source_file()}}

# Lint Markdown files
markdown:
    rumdl check .

# Check Java formatting without rewriting
java:
    find libs -name '*.java' -not -path '*/build/*' -print0 | xargs -0 -r google-java-format --dry-run --set-exit-if-changed

# Run every linter
all: markdown java
