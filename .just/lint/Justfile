set working-directory := "../.."

[private]
default:
    just --list --justfile {{source_file()}}

# Lint Markdown files
markdown:
    rumdl check .

# Check Java formatting without rewriting
java:
    find libs apps -name '*.java' -not -path '*/build/*' -print0 | xargs -0 -r google-java-format --dry-run --set-exit-if-changed

# Check formatting and declaration order in the toolpool lib
toolpool:
    moon run toolpool:lint

# Run every linter
all: markdown java toolpool
