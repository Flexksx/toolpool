set working-directory := "../.."

[private]
default:
    just --list --justfile {{source_file()}}

# Lint Markdown files
markdown:
    rumdl check .

# Check formatting and declaration order in every Java project
java:
    moon run '#java:lint'

# Check formatting and declaration order in the toolpool library modules only
toolpool:
    moon run '#toolpool-lib:lint'

# Run every linter
all: markdown java
