set working-directory := "../.."

[private]
default:
    just --list --justfile {{source_file()}}

# Format Nix files
nix:
    alejandra .

# Format Markdown files
markdown:
    rumdl check --fix .

# Format Java sources
java:
    find libs -name '*.java' -not -path '*/build/*' -print0 | xargs -0 -r google-java-format --replace

# Run every formatter
all: nix markdown java
