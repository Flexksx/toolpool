set working-directory := "../.."

[private]
default:
    just --list --justfile {{source_file()}}

# Format Nix files
nix:
    alejandra .

# Format Markdown files
markdown:
    rumdl check --fix .

# Format the Java sources of every Java project
java:
    moon run '#java:format'

# Format the Java sources of the toolpool library modules only
toolpool:
    moon run '#toolpool-lib:format'

# Run every formatter
all: nix markdown java
