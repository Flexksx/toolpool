set working-directory := "../.."

[private]
default:
    just --list --justfile {{source_file()}}

# Build the toolpool lib
toolpool:
    moon run toolpool:build

# Build the sample-rest-api-client lib
sample-rest-api-client:
    ./gradlew :libs:sample-rest-api-client:build

# Build the toolpool-demo app
toolpool-demo:
    moon run toolpool-demo:build

# Build every unit
all: toolpool sample-rest-api-client toolpool-demo
